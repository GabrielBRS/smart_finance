{
    "mojo.sdk.path": "${workspaceFolder}/.pixi/envs/default",

    "[mojo]": {
        "editor.defaultFormatter": "modular-mojotools.vscode-mojo",
        "editor.formatOnSave": true
    },

    "mojo.lsp.includeDirs": [
        "${workspaceFolder}/src"
    ],

    "terminal.integrated.env.linux": {
        "MOJO_PYTHON_LIBRARY": "${workspaceFolder}/.pixi/envs/default/lib/libpython3.14.so"
    }
}
