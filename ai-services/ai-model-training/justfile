set dotenv-load := false

default:
    @just --list

sync:
    uv sync

test:
    uv run pytest

prepare recipe="recipes/qwen/sft_lora.yaml":
    uv run llm-adaptation prepare --recipe {{recipe}}

train recipe="recipes/qwen/sft_lora.yaml":
    uv run llm-adaptation train --recipe {{recipe}}

evaluate recipe="recipes/qwen/sft_lora.yaml":
    uv run llm-adaptation evaluate --recipe {{recipe}}

export recipe="recipes/qwen/sft_lora.yaml":
    uv run llm-adaptation export --recipe {{recipe}}

sft-lora:
    uv run llm-adaptation train --recipe recipes/qwen/sft_lora.yaml

sft-qlora:
    uv run llm-adaptation train --recipe recipes/qwen/sft_qlora.yaml
